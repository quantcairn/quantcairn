# Copy this file to `.env.ai_selector.local` for local-only AI selector wiring.
# This file is optional and is loaded automatically by:
# - auto_trade.sh
# - multi_launch.sh
# - scripts/run_top_engine.sh
# - scripts/ai_selector_wrapper.py
# - scripts/run_ai_selector.py

# Keep disabled until you finish API key setup in the external projects.
SOXS_AI_SELECTOR_ENABLED=0
SOXS_OPENBB_ENABLED=0
SOXS_AI_SELECTOR_TOP_N=3
SOXS_AI_SELECTOR_ANALYSIS_UNIVERSE_LIMIT=9
SOXS_AI_SELECTOR_UNIVERSE=SOXS,LABD,DRIP,YINN,SOFI,SMR,NIO,QBTS,WULF
SOXS_TRADINGAGENTS_TIMEOUT_SECONDS=6
SOXS_TRADINGAGENTS_TOTAL_BUDGET_SECONDS=12
SOXS_FINROBOT_TIMEOUT_SECONDS=6
SOXS_FINROBOT_TOTAL_BUDGET_SECONDS=12
SOXS_OPENBB_TIMEOUT_SECONDS=4
SOXS_OPENBB_TOTAL_BUDGET_SECONDS=12
SOXS_OPENBB_ENABLE_STATEMENTS=0
SOXS_OPENBB_ENABLE_ESTIMATES=0

# TradingAgents real source path + dedicated python runtime.
SOXS_TRADINGAGENTS_PATH=/Users/chenwei/ai-research-projects/TradingAgents
SOXS_TRADINGAGENTS_PYTHON=/Users/chenwei/ai-research-projects/TradingAgents/.venv/bin/python

# Optional: pin research date. Leave empty to use today's date.
SOXS_TRADINGAGENTS_ANALYSIS_DATE=

# FinRobot real source path + dedicated python runtime.
SOXS_FINROBOT_PATH=/Users/chenwei/ai-research-projects/FinRobot
SOXS_FINROBOT_PYTHON=/Users/chenwei/ai-research-projects/FinRobot/.venv/bin/python
SOXS_FINROBOT_CONFIG=/Users/chenwei/ai-research-projects/FinRobot/finrobot_equity/core/config/config.ini
SOXS_FINROBOT_OUTPUT_DIR=/Users/chenwei/ai-research-projects/FinRobot/finrobot_equity/core/output
