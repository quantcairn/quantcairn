<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  QuantCairn — AI Selector Scheduler

  Runs the AI selector wrapper at two local Beijing times so launchd
  covers both US daylight-saving and standard-time market windows.
  The wrapper itself gates on US trading days and the matching ET
  pre-open window, so the secondary trigger is usually a no-op.

  Installation:
      cp deploy/launchd/com.quantcairn.ai-selector.plist.template \
         ~/Library/LaunchAgents/com.quantcairn.ai-selector.plist

  Edit the copied file and replace all REPLACE_WITH_* values.
  See deploy/launchd/README.md for full instructions.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.quantcairn.ai-selector</string>

    <key>ProgramArguments</key>
    <array>
        <string>REPLACE_WITH_PYTHON_PATH</string>
        <string>REPLACE_WITH_PROJECT_ROOT/scripts/ai_selector_wrapper.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>REPLACE_WITH_PROJECT_ROOT</string>

    <key>StandardOutPath</key>
    <string>REPLACE_WITH_PROJECT_ROOT/logs/ai_selector.out.log</string>

    <key>StandardErrorPath</key>
    <string>REPLACE_WITH_PROJECT_ROOT/logs/ai_selector.err.log</string>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>21</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>22</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>QUANTCAIRN_HOME</key>
        <string>REPLACE_WITH_PROJECT_ROOT</string>
        <key>SOXS_PROJECT_DIR</key>
        <string>REPLACE_WITH_PROJECT_ROOT</string>
        <key>YF_DISABLE_CURL_CFFI</key>
        <string>1</string>
        <!-- Enable verbose scheduler decision logging to stderr -->
        <key>OPENALPHA_WRAPPER_VERBOSE</key>
        <string>1</string>
    </dict>
</dict>
</plist>
